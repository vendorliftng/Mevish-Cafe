rules_version = '2';

// ═══════════════════════════════════════════════════════════════════
//  MEVISH RMS — Firestore Security Rules (Phase 1)
//
//  What IS enforced today:
//    - Admin/manager accounts (users) require Firebase Auth
//    - Only SuperAdmin can change roles
//    - Orders can never be deleted (voids are preserved)
//    - Audit log is create-only (immutable history)
//    - Inventory stock deductions allowed, but ONLY the currentStock field
//      can be modified by unauthenticated (customer/cashier) clients
//    - Everything not listed below is denied
//
//  What is NOT enforceable yet (documented in FIREBASE-DEPLOY.md):
//    - Cashier devices log in with a PIN, not Firebase Auth, so order
//      create/update must stay open to unauthenticated clients until
//      server-side PIN sessions (Cloud Functions) land in the next slice.
// ═══════════════════════════════════════════════════════════════════

service cloud.firestore {
  match /databases/{database}/documents {

    // ─── Helpers ──────────────────────────────────────────────
    function isSignedIn() {
      return request.auth != null;
    }
    function userRole() {
      return get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role;
    }
    function isManager() {
      return isSignedIn() && userRole() in ['Manager', 'Admin', 'SuperAdmin'];
    }
    function isSuperAdmin() {
      return isSignedIn() && userRole() == 'SuperAdmin';
    }

    // ─── users — admin/manager accounts (doc ID = Auth UID) ───
    match /users/{uid} {
      allow read: if isSignedIn();
      // Self-registration: the client creates its own doc.
      // New accounts are created as 'Pending' (or first-ever 'SuperAdmin').
      allow create: if isSignedIn() && request.auth.uid == uid;
      // Only SuperAdmin may change roles; a user may edit their own doc
      // but never their own role.
      allow update: if isSuperAdmin()
        || (isSignedIn() && request.auth.uid == uid
            && request.resource.data.role == resource.data.role);
      allow delete: if isSuperAdmin();
    }

    // ─── orders — the live order pipeline ─────────────────────
    match /orders/{orderId} {
      allow read: if true;                    // dashboards + (Phase 2) tracking
      allow create, update: if true;          // OPEN until cashier auth (Cloud Functions) — see header
      // Voids are preserved for everyone day-to-day — the one narrow
      // exception is the Super Admin's one-time "start fresh" data reset
      // (reset-data.html) before real customers begin using the system.
      allow delete: if isSuperAdmin();
    }

    // ─── shifts — cashier clock-in/out + sales reconciliation ──
    // Same posture as orders: PIN-pad login doesn't establish a Firebase
    // Auth session, so a cashier device is "unauthenticated" from
    // Firestore's point of view here too — this isn't a new exposure, it's
    // the same one every order write already has.
    match /shifts/{shiftId} {
      allow read: if true;
      allow create, update: if true;
      allow delete: if isSuperAdmin();
    }

    // ─── audit_log — immutable, append-only ───────────────────
    match /audit_log/{entry} {
      allow read: if isManager();
      allow create: if true;                  // cashier devices are unauthenticated
      allow update, delete: if false;
    }

    // ─── menu_items ───────────────────────────────────────────
    match /menu_items/{item} {
      allow read: if true;                    // customer menu, menu board
      // create used to be open to unauthenticated clients for first-run
      // FALLBACK_MENU seeding. The menu is fully seeded now and that
      // client-side auto-seed code has been removed (see config.js) — an
      // open create on a public collection with no ongoing purpose is
      // just an unmonitored way for anyone to write arbitrary menu items
      // (or worse, an inventory link + deduction quantity) with no
      // authentication at all. Adding a menu item now requires being a
      // Manager, same as editing or deleting one always has.
      allow create, update, delete: if isManager();
    }

    // ─── inventory ────────────────────────────────────────────
    match /inventory/{item} {
      allow read: if true;
      allow create, delete: if isManager();
      // Managers can change anything; unauthenticated clients may ONLY
      // adjust currentStock (transactional auto-deduction on new orders).
      allow update: if isManager()
        || request.resource.data.diff(resource.data).affectedKeys().hasOnly(['currentStock']);
    }

    // ─── expenses ─────────────────────────────────────────────
    match /expenses/{expense} {
      allow read, create, update, delete: if isManager();
    }

    // ─── system_config ────────────────────────────────────────
    match /system_config/{doc} {
      allow read: if true;                    // every page reads branding/settings at startup
      allow write: if isManager();
    }

    // ─── staff — cashier records ────────────────────────────────
    // Read is open so the unauthenticated cashier PIN pad (dashboard.html)
    // can look itself up client-side — there is no Cloud Function yet to do
    // that server-side (FR-1.4 is deferred pending a Blaze-plan decision).
    // This is NOT a new hole: the old GAS `cashiers` endpoint already
    // returned every PIN in plaintext to anyone who asked. Writes stay
    // Manager+ only.
    match /staff/{member} {
      allow read: if true;
      allow write: if isManager();
    }

    // ─── tables — seats/status/notes managed from the Tables & QR panel ──
    match /tables/{tableId} {
      allow read: if true;
      allow write: if isManager();
    }

    // ─── reviews ──────────────────────────────────────────────
    match /reviews/{reviewId} {
      allow read: if true;             // customer tracking page + public approved reviews
      allow create: if true;           // guest submits their own review, unauthenticated
      allow update: if isManager();    // approve/reject only
      allow delete: if isSuperAdmin(); // same one-time reset exception as orders, above
    }

    // ─── customers — loyalty (FR-11.3) ─────────────────────────
    // Points are earned at checkout and spend is credited at payment —
    // both happen from unauthenticated cashier/customer sessions, same as
    // orders itself, so create/update need to stay open. Only deleting a
    // customer record is Manager+.
    match /customers/{phone} {
      allow read: if true;
      allow create, update: if true;
      allow delete: if isManager();
    }

    // ─── everything else: deny ────────────────────────────────
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
